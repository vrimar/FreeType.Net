<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The audit feed is transient; an advisory published mid-build must not fail it. -->
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
      >true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <NativeArtifactsDir Condition="'$(NativeArtifactsDir)' == ''"
      >$(MSBuildThisFileDirectory)artifacts/native/</NativeArtifactsDir>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>FreeType.Net contributors</Authors>
    <Company>FreeType.Net</Company>
    <Product>FreeType.Net</Product>
    <Copyright>Copyright (c) FreeType.Net contributors</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>
    <IsPackable>false</IsPackable>
    <PackageLicenseExpression>MIT AND FTL</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/vrimar/FreeType.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vrimar/FreeType.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>freetype;font;fonts;glyph;text;truetype;opentype;native</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
    <None
      Include="$(MSBuildThisFileDirectory)README.md"
      Pack="true"
      PackagePath="/"
      Visible="false"
    />
    <None
      Include="$(MSBuildThisFileDirectory)LICENSE"
      Pack="true"
      PackagePath="/"
      Visible="false"
    />
    <None
      Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
      Pack="true"
      PackagePath="/"
      Visible="false"
    />
  </ItemGroup>
</Project>
